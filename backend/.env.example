# Spondon backend config — copy to `.env` and adjust.
# Server port = last 4 digits of student ID 23101184
PORT=1184
MONGODB_URI=mongodb://localhost:27017
DB_NAME=spondon

# Sleep Mode windows are wall-clock times set on a donor's phone, so all
# local-time maths uses this zone rather than UTC.
APP_TIMEZONE=Asia/Dhaka

# Browser origins allowed to call the API. Never use "*" with real credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token signing — set a long random value (>=32 bytes) in production.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
ADMIN_TOKEN_TTL_HOURS=12
USER_TOKEN_TTL_HOURS=720

# ── Rule constants (the engine and the UI both read these) ──────────
WHOLE_BLOOD_COOLDOWN_DAYS=120
PLATELET_COOLDOWN_DAYS=14
MIN_DONOR_WEIGHT_KG=50
PLAUSIBLE_WEIGHT_MIN_KG=30
PLAUSIBLE_WEIGHT_MAX_KG=250
LOCATION_STALE_AFTER_MINUTES=15
# Unanswered city-wide rare ping → external sourcing. 3 minutes by default;
# drop it to ~30 for a live demo so the escalation is watchable.
RARE_ESCALATION_SECONDS=180
# How often the server sweeps for rare requests past that threshold, so the
# escalation fires on its own rather than waiting for a client to re-evaluate.
ESCALATION_SWEEP_SECONDS=20
# Rare types also go out by SMS, not push alone — too few donors exist to lose
# one to a stale FCM token.
RARE_SMS_ALERTS=true

# Twilio (used ahead of the local gateway when both are configured)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+8801XXXXXXXXX
# ── Live En-Route Tracker ───────────────────────────────────────────
# How often the donor's app posts a fix, and how much silence counts as the
# phone having lost its connection. When the gap is exceeded the family's icon
# freezes and the ETA is flagged stale rather than continuing to count down.
TRIP_PING_INTERVAL_SECONDS=10
TRIP_STALE_AFTER_SECONDS=45
TRIP_SWEEP_SECONDS=5
TRIP_ARRIVAL_RADIUS_M=120
# Dhaka traffic, not a highway. The ETA uses the donor's measured speed once
# there is enough movement to measure, clamped into the band below.
TRIP_DEFAULT_SPEED_KMH=18
TRIP_MIN_SPEED_KMH=6
TRIP_MAX_SPEED_KMH=60
# Straight-line km → road km when GOOGLE_MAPS_API_KEY is unset.
TRIP_ROAD_FACTOR=1.35

# ── Direct-Connect Masked Calling ───────────────────────────────────
CALL_SESSION_TTL_MINUTES=180
# Below either floor for CALL_DEGRADED_SECONDS, the client abandons the VOIP
# leg and the same call continues on a borrowed GSM number.
CALL_MIN_MOS=2.5
CALL_MAX_PACKET_LOSS_PCT=8
CALL_DEGRADED_SECONDS=5
# The pool of platform-owned numbers lent out for that fallback. Replace with
# real numbers from your telephony provider before deploying.
GSM_PROXY_NUMBERS=+8809612000101,+8809612000102,+8809612000103,+8809612000104
# Telephony bridge that maps the pair to the proxy number (e.g. Twilio Proxy).
# Unset means the GSM leg is simulated locally and the API says so.
# VOICE_BRIDGE_URL=
# VOICE_BRIDGE_KEY=

OCR_CONFIDENCE_THRESHOLD=0.75
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── External integrations ───────────────────────────────────────────
# Every one of these is optional. Leave a block unset and its adapter reports
# itself as unconfigured rather than pretending to have delivered anything.
# `GET /api/config` lists exactly which are live.

# SMS gateway for OTP delivery (e.g. SSL Wireless).
# With no gateway, the OTP is returned in the API response for local testing.
# SMS_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms
# SMS_API_KEY=
# SMS_SENDER_ID=SPONDON
# EXPOSE_OTP_IN_RESPONSE=auto        # auto | true | false

# Firebase Cloud Messaging — emergency pings, incl. DND-piercing alarms.
# FCM_SERVER_KEY=

# OpenAI — doctor's-slip OCR. Unset means every slip goes to human review.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# CBC Triage — minimum readable CBC uploads before a trend verdict is issued.
# Raise this for stricter triage; lower it for demo purposes.
# CBC_MIN_REPORTS=2

# Google Maps — driving-route distance, so a 3 km radius does not include
# donors across a river with no bridge.
# GOOGLE_MAPS_API_KEY=

# National blood-bank registry and partner NGO hotlines — the dead-end
# escalation path for an unanswered rare-blood request.
# BLOOD_BANK_API_URL=
# BLOOD_BANK_API_KEY=
# NGO_HOTLINE_API_URL=

# ── Post-Donation Ride Community Bounty ──────────────────────────────
# How long the community has to offer a platelet donor a lift home before
# the promo-code fallback fires. Drop it to ~1 for a live demo.
# BOUNTY_WINDOW_MINUTES=15
# How far from the hospital a community driver can be and still be asked.
# BOUNTY_RADIUS_KM=5.0
# How often the server sweeps for windows that have run out.
# BOUNTY_SWEEP_SECONDS=15
# Ride-sharing partners the subsidy is drawn against, in preference order.
# RIDE_PARTNERS=Pathao,Uber
# BOUNTY_PROMO_PREFIX=SPONDON
# BOUNTY_PROMO_TTL_HOURS=24
# BOUNTY_PROMO_VALUE_BDT=300
# Partner B2B voucher API. Without a key the code is still randomly generated
# per donor, but the booking is simulated rather than registered with Pathao.
# RIDE_PARTNER_API_URL=
# RIDE_PARTNER_API_KEY=
