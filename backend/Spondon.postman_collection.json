            "url": {
              "raw": "{{baseUrl}}/api/golden/me/city",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "golden",
                "me",
                "city"
              ]
            },
            "description": "The donor tells us they have moved away. Their badge is untouched — only the front-of-queue placement on ICU dispatches is paused, because a donor in Chattogram cannot reach a Dhaka ICU in time and the seconds spent ringing them are seconds the patient pays for.\n\nExpect status SUSPENDED, priority_active false, is_golden STILL TRUE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Chattogram\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4.4b …and move back",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              }
