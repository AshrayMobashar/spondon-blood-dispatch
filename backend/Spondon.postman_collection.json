    {
      "name": "Feature 4 — Golden Donor Verification",
      "description": "Three confirmed donations earn a verified Golden Donor badge and priority placement on ICU dispatches. The badge is permanent; the priority is suspended while the donor is outside Dhaka or has not opened the app for six months, and restores itself the moment they are active again.\n\nSet {{user_token}} from a donor's /api/auth/otp/verify response before running anything below except 4.1.",
      "item": [
        {
          "name": "4.1 Published rules (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/golden/rules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "golden",
                "rules"
              ]
            },
            "description": "The terms of the scheme, served from the same constants the dispatcher reads — so a screen can never advertise a threshold the engine does not use. No token needed: a donor deciding whether to bother should not have to sign up to read the rules."
          }
        },
        {
          "name": "4.2 My Golden Donor status  ⭐",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/golden/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "golden",
                "me"
              ]
            },
            "description": "Badge, progress, priority, and — if suspended — exactly why.\n\nA PURE READ: it deliberately does not count as activity. If opening this screen refreshed the dormancy clock, a donor could never see their own suspension, because the act of looking would clear it."
          }
        },
        {
          "name": "4.3 Restore a lapsed priority  ⭐ corner case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
