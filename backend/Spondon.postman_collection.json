    {
      "name": "Feature 3 — Varsity Node Leaderboard",
      "description": "Public monthly ranking of universities by fulfilled emergency requests. Run seed_leaderboard.py first for 13 months of dummy history. Scoring is on arrival, not acceptance; universities level on points are separated by average ping-to-acceptance time.",
      "item": [
        {
          "name": "Published months (the 12-month window)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard/months",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leaderboard",
                "months"
              ]
            },
            "description": "The months the board publishes, ending with the one in progress. Clients build their month picker from this, so an upcoming month is never offered."
          }
        },
        {
          "name": "Leaderboard — current month (live)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leaderboard"
              ]
            },
            "description": "Omitting ?month returns the month in progress."
          }
        },
        {
          "name": "Leaderboard — a settled month (3-way tie)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard?month=2026-03",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leaderboard"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-03"
                }
              ]
            },
            "description": "The seeded March board ends in a three-way tie on points; each tied entry carries a tie_break_note naming the response time that separated it."
          }
        },
        {
          "name": "CORNER CASE — upcoming month is refused (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard?month=2099-01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leaderboard"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2099-01"
                }
              ]
            },
            "description": "A future month is rejected rather than answered with an empty board: an empty board reads as 'nobody donated', which is a different claim from 'that month has not happened yet'."
          }
        },
        {
          "name": "CORNER CASE — older than the window is refused (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard?month=2000-01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leaderboard"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2000-01"
                }
              ]
            }
          }
        },
        {
          "name": "Varsity node roster",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard/universities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leaderboard",
                "universities"
              ]
            },
            "description": "Also feeds the campus picker at donor sign-up. Registration matches against this roster, so free text cannot split one node into three."
          }
        },
        {
          "name": "One campus's month",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard/BRACU?month=2026-03",
