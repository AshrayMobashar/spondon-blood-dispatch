            "url": {
              "raw": "{{baseUrl}}/api/golden/me/city",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "golden",
                "me",
                "city"
              ]
            },
            "description": "The same field carries the return. A declaration outranks GPS in both directions: a donor who says they are back is trusted immediately rather than waiting for their phone to report a fix from the new address.\n\nSend \"\" instead to clear the declaration and fall back to their GPS fix.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Dhaka\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
